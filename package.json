{
  "name": "karont",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron dist/desktop/main.cjs",
    "daemon": "node dist/daemon/entry.cjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "test:desktop": "npm run build && node scripts/desktop-test.mjs",
    "test:e2e": "npm run build && node scripts/phase1-e2e.mjs && node scripts/spec005-e2e.mjs && node scripts/spec006-e2e.mjs",
    "daemon:status": "node scripts/daemon-control.mjs",
    "daemon:stop": "node scripts/daemon-control.mjs --stop",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "benchmark:report": "node scripts/report.mjs",
    "sandbox:diagnose": "node scripts/sandbox-diagnose.mjs",
    "benchmark:series": "npm run build && node scripts/benchmark-series.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
